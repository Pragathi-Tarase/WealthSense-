{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/ml/saved_models/**",
      "excludeFiles": "{frontend/**,.git/**,.vercel/**,.vscode/**}"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/auth/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/",
      "dest": "/frontend/intro.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
