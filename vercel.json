{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/ml/saved_models/**",
      "excludeFiles": "{public/**,.git/**,.vercel/**,.vscode/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/",
      "destination": "/intro.html"
    }
  ]
}
